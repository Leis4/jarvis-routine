# JARVIS Routine — optional Worker configuration (example).
# Copy to backend/.dev.vars for local development and set the same secrets
# through `wrangler secret put` in production. Never commit real values.

APP_ACCESS_TOKEN=change-me-to-a-long-random-token
ALLOWED_ORIGIN=http://localhost:8080

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:demo@example.com

QWEN_BASE_URL=https://api.example.com/v1
AITUNNEL_API_KEY=
